# Discord 채널 설정 → 연동(Integrations) → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=
# 결재 회신 읽기용 봇 (Developer Portal → Bot → Token, MESSAGE CONTENT INTENT 켜기)
DISCORD_BOT_TOKEN=
# 채널 ID (개발자 모드 켜고 채널 우클릭 → ID 복사)
DISCORD_CHANNEL_ID=
# 오너 본인 Discord 사용자 ID — 이 사람의 메시지만 결재로 인정
DISCORD_OWNER_ID=

# 결재 메일 수신 주소 (오너 본인)
OWNER_EMAIL=
